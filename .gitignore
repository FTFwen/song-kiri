# 忽略系统与编辑器产生的文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# 日志与临时目录
*.log
.dsh-tmp/
tmp/

# 无头浏览器自检用的临时探针页（见 AGENTS.md 第 10 节，用完即删，绝不入库）
/_probe.html
/_verify.html
/_test.html
/_layout.html

# 依赖（本工程不依赖构建工具，仅作兜底）
node_modules/

# 歌曲素材：音频与封面不入库，各设备用 tools/fetch-media.mjs 自行拉取
media/

# Cloudflare 发布用：deploy-stage/ 由 tools/stage-deploy.mjs 现生成（含硬链接的 media，绝不入库）
deploy-stage/

# wrangler 自己的缓存
.wrangler/
